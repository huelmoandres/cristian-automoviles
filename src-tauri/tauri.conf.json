{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cristian Automóviles",
  "version": "0.1.1",
  "identifier": "com.cristianautomoviles.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Cristian Automóviles",
        "width": 1280,
        "height": 820,
        "minWidth": 1024,
        "minHeight": 680,
        "center": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/vehicle-images/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Cristian Automóviles",
    "shortDescription": "Gestión de stock, ventas y cobranzas",
    "longDescription": "Stock de vehículos, clientes, ventas financiadas en cuotas, cobranzas y recargos por mora.",
    "category": "Business",
    "windows": {
      "nsis": {
        "languages": [
          "Spanish"
        ],
        "displayLanguageSelector": false,
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDAxMjMzQUU0N0RCQzk4REYKUldUZm1MeDk1RG9qQWExOHBXcmExN3h1amxGL2kwZFpJRXJraHRmR0dGNmNUbUNVVFVkUFVnRSsK",
      "endpoints": [
        "https://github.com/huelmoandres/cristian-automoviles/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
